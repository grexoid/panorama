<!doctype html>
<html lang="en" class="no-js" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ site.title }}{% endblock %}</title>
  {% block meta %}
  {% if site.tagline %}<meta name="description" content="{{ site.tagline }}">{% endif %}
  {% endblock %}
  {% if encrypted %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <meta name="color-scheme" content="dark light">
  <link rel="icon" href="{{ root }}favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ root }}static/style.css?v={{ assets.css }}">
  <script>
    /* Runs before first paint: enables JS-only styles and restores the saved theme. */
    (function () {
      var root = document.documentElement;
      root.classList.replace('no-js', 'js');
      try {
        var saved = localStorage.getItem('gallery-theme');
        if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
      } catch (e) {}
    })();
  </script>
  <script src="{{ root }}static/app.js?v={{ assets.js }}" defer></script>
  {% if encrypted %}<script src="{{ root }}static/secure.js?v={{ assets.secure }}" defer></script>{% endif %}
</head>
<body class="{% block body_class %}{% endblock %}">

{% block topbar %}{% endblock %}

{% block main %}{% endblock %}

<footer class="footer">
  <p>
    {{ counts.project }} project{{ '' if counts.project == 1 else 's' }} ·
    {{ counts['use-case'] }} use case{{ '' if counts['use-case'] == 1 else 's' }} ·
    built {{ built_on.day }} {{ built_on.strftime('%b %Y') }}
    {% if site.footer %}· {{ site.footer }}{% endif %}
    {% if site.contribute_url %}· <a href="{{ site.contribute_url }}" target="_blank" rel="noopener">Contribute a card</a>{% endif %}
    {% if not encrypted %}· <a href="{{ root }}projects.json">JSON</a>{% endif %}
  </p>
</footer>

</body>
</html>
